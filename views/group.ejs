<%- include('include/header') -%>

<main>
    <a href="/dashboard" class="back-link">← Back to Dashboard</a>
    <h2>🎄 <%= group.name %></h2>

    <% if (giftee) { %>
    <div class="success-box">
        <h3>🎁 Your Secret Santa Assignment</h3>
        <p>You have been assigned to get a gift for:</p>
        <p><strong><%= giftee %></strong></p>
        <div class="decoration">🎄 🎁 🎄</div>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="error-box">
        <p><%= error %></p>
    </div>
    <% } %>

    <% if (!group.solved) { %>
    <section>
        <h3>🔗 Signup Link</h3>
        <p>Share this link with your group members so they can select their giftee:</p>
        <div class="link-box">
            <input type="text" id="signupLink" value="<%= signupLink %>" readonly>
            <button onclick="navigator.clipboard.writeText(document.getElementById('signupLink').value); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)">Copy</button>
        </div>
    </section>

    <section>
        <h3>➕ Add Member</h3>
        <form action="/groups/<%= group._id %>/members" method="POST">
            <div>
                <label for="memberName">Member Name</label>
                <input type="text" id="memberName" name="name" placeholder="Enter member's name" required>
            </div>
            <button type="submit" class="btn-secondary">Add Member</button>
        </form>
    </section>
    <% } %>

    <section>
        <h3>👥 Members (<%= members.length %>)</h3>
        <% if (members && members.length > 0) { %>
            <ul>
                <% members.forEach(member => { %>
                    <li>
                        <span><%= member.name %></span>
                        <% if (member.isOwner) { %>
                            <span class="badge badge-owner">You</span>
                        <% } %>
                        <% if (member.giftee) { %>
                            <span class="badge badge-success">✓ Selected</span>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No members added yet.</p>
        <% } %>
    </section>

    <section>
        <h3>⚠️ Danger Zone</h3>
        <p>This will permanently delete the group and all its members.</p>
        <form action="/groups/<%= group._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this group? This cannot be undone.');">
            <button type="submit" class="btn-danger">🗑️ Delete Group</button>
        </form>
    </section>
</main>

<%- include('include/footer') -%>
