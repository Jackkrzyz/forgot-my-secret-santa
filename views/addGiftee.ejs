<%- include('include/header') -%>

<main>
    <div class="hero" style="padding: 2rem;">
        <span class="emoji">🎁</span>
        <h1><%= group.name %></h1>
        <p class="subtitle">Select your name and choose who you'll be getting a gift for!</p>
    </div>

    <section>
        <h3>🎄 Make Your Selection</h3>
        
        <form id="gifteeForm">
            <div>
                <label for="memberSelect">Who are you?</label>
                <select name="member" id="memberSelect" required>
                    <option value="">-- Select your name --</option>
                    <% members.forEach(function(member) { %>
                        <% if (!member.isOwner) { %>
                            <option value="<%= member._id %>"><%= member.name %></option>
                        <% } %>
                    <% }); %>
                </select>
            </div>
            
            <div>
                <label for="gifteeSelect">Who will you get a gift for?</label>
                <select name="giftee" id="gifteeSelect" required>
                    <option value="">-- Select your giftee --</option>
                    <% members.forEach(function(member) { %>
                        <option value="<%= member._id %>"><%= member.name %></option>
                    <% }); %>
                </select>
            </div>

            <button type="button" id="assignGifteeBtn">🎁 Confirm My Giftee</button>
        </form>
    </section>
</main>

<script>
    document.getElementById('assignGifteeBtn').addEventListener('click', function() {
        const memberId = document.getElementById('memberSelect').value;
        const gifteeId = document.getElementById('gifteeSelect').value;
        
        if (!memberId) {
            alert('Please select your name.');
            return;
        }
        if (!gifteeId) {
            alert('Please select a giftee.');
            return;
        }
        if (memberId === gifteeId) {
            alert('You cannot assign yourself as your own giftee! 🎅');
            return;
        }
        
        this.disabled = true;
        this.textContent = 'Submitting...';
        
        fetch(`/members/${memberId}/giftee`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ gifteeId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.href = '/thankyou';
            } else {
                alert('Error: ' + data.message);
                this.disabled = false;
                this.textContent = '🎁 Confirm My Giftee';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Something went wrong. Please try again.');
            this.disabled = false;
            this.textContent = '🎁 Confirm My Giftee';
        });
    });
</script>

<%- include('include/footer') -%>